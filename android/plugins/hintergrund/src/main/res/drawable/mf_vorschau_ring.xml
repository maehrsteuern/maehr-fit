<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
    <path
        android:pathData="M48,8 A40,40 0 1,1 47.99,8"
        android:strokeColor="@color/mf_hg_spur"
        android:strokeWidth="8"
        android:fillColor="#00000000" />
    <path
        android:pathData="M48,8 A40,40 0 1,1 9.26,57.95"
        android:strokeColor="@color/mf_hg_erholung_gruen"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>

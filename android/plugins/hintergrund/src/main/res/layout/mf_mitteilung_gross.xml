<?xml version="1.0" encoding="utf-8"?>
<!-- Morgenbericht aufgeklappt: links der Ring (dunkle Fläche, Zahl in der Mitte), daneben Erholung · Belastung · Schlaf mit großen
     Zahlen, darunter der Satz aus „Heute“. Höchstens 252 dp hoch (Grenze ab Android 12). Die Farbe der Erholungszahl setzt
     Mitteilungen.kt je Stufe (values/values-night, also lesbar auf hellem und dunklem System). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mf_mt_ring"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginEnd="14dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mf_mt_erholung_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />

            <TextView
                android:id="@+id/mf_mt_erholung_wert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mf_mt_erholung_unter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mf_mt_belastung_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />

            <TextView
                android:id="@+id/mf_mt_belastung_wert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mf_mt_schlaf_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />

            <TextView
                android:id="@+id/mf_mt_schlaf_wert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mf_mt_schlaf_unter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/mf_mt_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textAppearance="@android:style/TextAppearance.Material.Notification" />
</LinearLayout>

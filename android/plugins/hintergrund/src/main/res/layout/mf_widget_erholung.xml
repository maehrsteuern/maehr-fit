<?xml version="1.0" encoding="utf-8"?>
<!-- Widget „Erholung“ 2 × 2. Nur Ansichten, die RemoteViews erlauben (FrameLayout, LinearLayout, TextView, ImageView).
     Die Texte hier sind die Vorschau (ab Android 12 previewLayout); im Betrieb setzt Widgets.kt alles. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mf_w_wurzel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mf_widget_hintergrund"
    android:clipToOutline="true"
    android:padding="@dimen/mf_widget_rand">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mf_w_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="@string/mf_hg_erholung"
            android:textAllCaps="true"
            android:textColor="@color/mf_hg_neben"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/mf_w_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/mf_vorschau_ring" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mf_w_zahl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:text="71"
                    android:textColor="@color/mf_hg_tinte"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mf_w_prozent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:text="%"
                    android:textColor="@color/mf_hg_neben"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/mf_w_stufe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="1"
            android:text="@string/mf_hg_stufe_gruen"
            android:textColor="@color/mf_hg_erholung_gruen"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mf_w_zuletzt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/mf_hg_vorschau_zuletzt"
            android:textColor="@color/mf_hg_neben"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>

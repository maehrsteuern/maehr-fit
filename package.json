{
  "name": "maehr-fit",
  "version": "0.1.0",
  "private": true,
  "description": "MAEHR FIT – persönliche Gesundheits-App: Erholung, Belastung, Schlaf. Daten bleiben auf dem Gerät.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/node/*.test.mjs",
    "bau": "python3 bau.py && python3 android/bau_dist.py",
    "android:sync": "npm run bau && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^6.1.0",
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
